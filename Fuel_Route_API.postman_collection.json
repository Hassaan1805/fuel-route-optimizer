{
  "info": {
    "_postman_id": "c1f7b920-8e12-4293-8472-a9b1c7d2e4f0",
    "name": "FuelPath - Optimal Fuel Routing API",
    "description": "Requests for the Optimal Fuel Routing API (Django + DRF).\nEach route request has tests that check the plan: every leg is within the vehicle range, stop costs add up to total_fuel_cost, and at most one external routing call was made.\nSet the baseUrl variable to wherever the server runs (default http://127.0.0.1:8000).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Long Cross-Country Route (NY to LA - GET)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/route/?start=New York, NY&finish=Los Angeles, CA&max_range=500&mpg=10",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "route",
            ""
          ],
          "query": [
            {
              "key": "start",
              "value": "New York, NY",
              "description": "Starting US location"
            },
            {
              "key": "finish",
              "value": "Los Angeles, CA",
              "description": "Destination US location"
            },
            {
              "key": "max_range",
              "value": "500",
              "description": "Vehicle maximum range in miles"
            },
            {
              "key": "mpg",
              "value": "10",
              "description": "Vehicle fuel efficiency (10 mpg)"
            }
          ]
        },
        "description": "Computes optimal fuel stops for ~2,790 mile coast-to-coast route from New York to Los Angeles."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "const data = pm.response.json();",
              "pm.test('Plan found', () => pm.expect(data.success).to.be.true);",
              "pm.test('At most one routing API call', () => pm.expect(data.meta.routing_api_calls).to.be.at.most(1));",
              "pm.test('Every leg within vehicle range', () => {",
              "    const range = data.vehicle_specs.max_vehicle_range_miles;",
              "    data.fuel_stops.forEach(s => pm.expect(s.leg_distance_miles).to.be.at.most(range));",
              "    pm.expect(data.final_leg_miles).to.be.at.most(range);",
              "});",
              "pm.test('Stop costs add up to total', () => {",
              "    const sum = data.fuel_stops.reduce((acc, s) => acc + s.cost_at_stop, 0);",
              "    pm.expect(sum).to.be.closeTo(data.total_fuel_cost, 0.01);",
              "});",
              "pm.test('Gallons = distance / mpg', () => {",
              "    const expected = data.total_distance_miles / data.vehicle_specs.fuel_efficiency_mpg;",
              "    pm.expect(data.total_fuel_gallons).to.be.closeTo(expected, 0.2);",
              "});"
            ]
          }
        }
      ]
    },
