    {
      "name": "3. Data-Gap Route (Seattle to San Diego) - expects 422",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/route/?start=Seattle, WA&finish=San Diego, CA&max_range=500&mpg=10",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "route",
            ""
          ],
          "query": [
            {
              "key": "start",
              "value": "Seattle, WA"
            },
            {
              "key": "finish",
              "value": "San Diego, CA"
            },
            {
              "key": "max_range",
              "value": "500"
            },
            {
              "key": "mpg",
              "value": "10"
            }
          ]
        },
        "description": "The provided price list has almost no stations in California/Oregon, so I-5 has a ~1,000-mile stretch with no fuel. The API returns 422 with the exact gap instead of a bad plan."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 422 (no stations in the price list along I-5 in CA/OR)', () => pm.response.to.have.status(422));",
              "pm.test('Explains the gap', () => pm.expect(pm.response.json().error).to.include('no stations between'));"
            ]
          }
        }
      ]
    },
